# Optional runtime config for autorunner
# Copy to .env in the same folder and adjust values for your machine.

# Agent backend used by autorunner/loop_runner.py and autorunner/parallel_runner.py.
# Supported values: claude, codex
AR_AGENT_BACKEND=claude

# Claude backend model.
AR_MODEL=deepseek-v4-pro[1m]

# Codex backend model. Used only when AR_AGENT_BACKEND=codex.
# AR_CODEX_MODEL=gpt-5.2

# Optional Codex execution policy.
# AR_CODEX_SANDBOX=danger-full-access
# AR_CODEX_APPROVAL_POLICY=never
# AR_CODEX_EPHEMERAL=1

# Optional binary overrides and extra CLI args.
# AR_CLAUDE_BINARY=claude
# AR_CODEX_BINARY=codex
# AR_CLAUDE_EXTRA_ARGS=
# AR_CODEX_EXTRA_ARGS=

# Project root path used by runners
AR_WORKDIR=/mount/disk1/rl-hyr/autoresearch
